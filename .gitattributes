* text=auto
*.ps1 text eol=crlf
*.c text eol=lf
*.h text eol=lf
*.go text eol=lf
*.mod text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.docx binary
# Preserve diagnostic output and archived sources byte-for-byte (SHA-256).
# Whitespace in captured diffs/compiler reports is part of the raw evidence.
resultados/diagnostico/** -text -whitespace
resultados/piloto/s06_windows_*/** -text -whitespace
docs/optimizaciones_i7_original_s06.md -whitespace
resultados/experimentos/granularidad_go/** -whitespace

# Preserve I4 original pilot observations and logs without newline conversion.
resultados/piloto/s07_i04_go_paralelo/** -text -whitespace
# Preserve native integrated S7 campaign observations and logs byte-for-byte.
resultados/piloto/s07_windows_20261117_*/** -text -whitespace
